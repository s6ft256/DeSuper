{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "runtime": "vercel-python@1.0.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
